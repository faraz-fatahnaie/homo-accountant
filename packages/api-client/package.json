{
  "name": "@arya/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed API client generated from the FastAPI OpenAPI contract",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/openapi.json -o src/schema.d.ts && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.8.3"
  }
}
