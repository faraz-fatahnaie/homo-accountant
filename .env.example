# ============================================================
# Arya Tejarat — environment template (copy to .env, never commit .env)
# ============================================================

# --- API ---
ARYA_ENVIRONMENT=development          # development | test | production
ARYA_JWT_SECRET=change-me-32+chars-random-string
ARYA_DATABASE_URL=postgresql+psycopg://arya:arya_dev_pw@127.0.0.1:5432/arya_dev
ARYA_CORS_ORIGINS=http://localhost:3000
ARYA_ACCESS_TOKEN_MINUTES=30
ARYA_REFRESH_TOKEN_DAYS=7
ARYA_LOGIN_RATE_LIMIT_PER_MINUTE=10
ARYA_SEED_DEMO_USERS=true

# --- First-admin bootstrap (production) ---
ARYA_ADMIN_BOOTSTRAP_EMAIL=
ARYA_ADMIN_BOOTSTRAP_PASSWORD=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- PostgreSQL (compose) ---
POSTGRES_USER=arya
POSTGRES_PASSWORD=arya_dev_pw
POSTGRES_DB=arya_dev

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=aryaminio
MINIO_ROOT_PASSWORD=arya_minio_dev_pw
ARYA_S3_BUCKET=arya-attachments

# --- Deploy ---
IMAGE_TAG=latest
